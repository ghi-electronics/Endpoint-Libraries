<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Pins.EPM815</PackageId>
    <Description>EPM815 module pin constants and peripheral bus tables for Endpoint. Reference this from a project that targets EPM815; it transitively pulls in Core and the STM32MP1 chip helpers.</Description>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHIElectronics.Endpoint.Core\GHIElectronics.Endpoint.Core.csproj" />
    <ProjectReference Include="..\GHIElectronics.Endpoint.Pins.Stm32Mp1\GHIElectronics.Endpoint.Pins.Stm32Mp1.csproj" />
  </ItemGroup>
</Project>
