<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Update</PackageId>
    <Description>The update driver for Endpoint.</Description>
    <Nullable>disable</Nullable>
    <!-- Not shipped in 0.3.0: no design yet. Still compiles so the source
         doesn't rot; the EndpointPack target skips packing when this is false. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHIElectronics.Endpoint.Core\GHIElectronics.Endpoint.Core.csproj" />
    <ProjectReference Include="..\GHIElectronics.Endpoint.Native\GHIElectronics.Endpoint.Native.csproj" />
    <!-- Default parameter EPM815.Gpio.Pin.NONE; EPM815-specific today, no
         chip-neutral replacement yet so depend on the single Pins package. -->
    <ProjectReference Include="..\GHIElectronics.Endpoint.Pins\GHIElectronics.Endpoint.Pins.csproj" />
  </ItemGroup>
</Project>
