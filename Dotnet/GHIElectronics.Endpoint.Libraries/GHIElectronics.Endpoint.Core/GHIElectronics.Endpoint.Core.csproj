<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Core</PackageId>
    <Description>Core of the Endpoint libraries: board pin names and pin setup.</Description>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Device.Gpio" Version="4.2.0" />
  </ItemGroup>

  <!-- libendpoint (Endpoint-Libraries/native, built for the board), for the
       features .NET shares with Python and C++ (storage): in the NuGet
       package for linux-arm, and next to the program for projects that
       reference this one. Build native/ first (its CMake preset "endpoint"). -->
  <PropertyGroup>
    <Libendpoint>$(MSBuildThisFileDirectory)..\..\..\native\build\libendpoint.so</Libendpoint>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(Libendpoint)" Link="libendpoint.so" Pack="true" PackagePath="runtimes/linux-arm/native"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="CheckLibendpoint" BeforeTargets="Build">
    <Error Condition="!Exists('$(Libendpoint)')" Text="$(Libendpoint) is missing: build Endpoint-Libraries/native first" />
  </Target>

</Project>
