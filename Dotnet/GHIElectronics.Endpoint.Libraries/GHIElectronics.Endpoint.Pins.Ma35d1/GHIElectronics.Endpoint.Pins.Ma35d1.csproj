<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Pins.Ma35d1</PackageId>
    <Description>Nuvoton MA35D1 chip-level pin encoding and register helpers for Endpoint. Pulled in transitively by board pin packages (Pins.EPN256); user projects reference the board package, not this one.</Description>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHIElectronics.Endpoint.Core\GHIElectronics.Endpoint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GHIElectronics.Endpoint.Pins.EPN256" />
  </ItemGroup>
</Project>
