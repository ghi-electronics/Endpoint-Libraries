<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Pins.Stm32Mp1</PackageId>
    <Description>STM32MP1 chip-level pin encoding and register helpers for Endpoint. Pulled in transitively by board pin packages (Pins.EPM815, Pins.EPDomino24); user projects reference the board package, not this one.</Description>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHIElectronics.Endpoint.Core\GHIElectronics.Endpoint.Core.csproj" />
  </ItemGroup>

  <!-- EPM815 (the SOM package that sits on top of STM32MP1) is the only
       consumer that needs the chip helpers. Keep them internal here and
       grant access just to EPM815. -->
  <ItemGroup>
    <InternalsVisibleTo Include="GHIElectronics.Endpoint.Pins.EPM815" />
  </ItemGroup>
</Project>
