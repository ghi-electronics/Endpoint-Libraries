<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Devices.Can</PackageId>
    <Description>CAN for Endpoint: .NET IoT's CanRaw (Iot.Device.SocketCan) on the board's CAN ports. EPM815.Can.Initialize sets a port up.</Description>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHIElectronics.Endpoint.Core\GHIElectronics.Endpoint.Core.csproj" />
    <!-- CanRaw (Iot.Device.SocketCan) is in Microsoft's .NET IoT bindings -->
    <PackageReference Include="Iot.Device.Bindings" Version="4.2.0" />
  </ItemGroup>

</Project>
