<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Pins.Ma35d0</PackageId>
    <Description>Nuvoton MA35D0 chip-level pin encoding and register helpers for Endpoint. Pulled in transitively by board pin packages (Pins.EPN128); user projects reference the board package, not this one. Register-identical to MA35D1 today; kept separate so the two chips can diverge later without reshuffling packages.</Description>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GHIElectronics.Endpoint.Core\GHIElectronics.Endpoint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GHIElectronics.Endpoint.Pins.EPN128" />
  </ItemGroup>
</Project>
