<Project>
  <!-- Shared settings of the Endpoint libraries. Each project imports this
       file first; the NuGet package details come from here and from the
       project's PackageId and Description (no .nuspec files). -->

  <PropertyGroup>
    <!-- One version for every library: change it here for a release -->
    <EndpointLibrariesVersion>0.5.0</EndpointLibrariesVersion>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Apps built with Native AOT (Ctrl+F5) can use every library: the
         analyzers warn about code that would not work there -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Version>$(EndpointLibrariesVersion)</Version>
    <Authors>GHI Electronics, LLC</Authors>
    <Company>GHI Electronics, LLC</Company>
    <Product>Endpoint</Product>
    <Copyright>Copyright GHI Electronics, LLC 2026</Copyright>
    <PackageProjectUrl>https://ghielectronics.com/</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Endpoint GHI</PackageTags>
    <!-- SPDX license expression (modern replacement for PackageLicenseUrl). -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- Source repository link shown on the nuget.org package page. -->
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ghi-electronics/Endpoint-Libraries</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)images\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md"       Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The packages need each other (GHIElectronics.Endpoint.Core, ...) at their own
       version or newer, below the next minor version: 0.5.0 needs
       [0.5.0, 0.6.0), so updating one package does not break the others.
       The rule that makes this safe: within a minor version (0.5.x) the libraries
       only add, never change or remove; a breaking change goes to the next one
       (0.6). NuGet makes a project reference ">= its version" by itself; this
       adds the upper end. Pre-releases of the next minor (0.6.0-beta) are kept
       out by NuGet's default stability filter: a stable package never resolves
       to a prerelease transitive dep unless the consumer opts in. Do NOT use
       the "-0" upper-bound trick ("0.6.0-0"): nuget.org's server rejects that
       string as an invalid version even though local pack tools accept it. -->
  <PropertyGroup>
    <_EndpointMajor>$([System.Text.RegularExpressions.Regex]::Replace($(EndpointLibrariesVersion), '^(\d+)\.(\d+).*$', '$1'))</_EndpointMajor>
    <_EndpointMinor>$([System.Text.RegularExpressions.Regex]::Replace($(EndpointLibrariesVersion), '^(\d+)\.(\d+).*$', '$2'))</_EndpointMinor>
    <EndpointCompatibleBelow>$(_EndpointMajor).$([MSBuild]::Add($(_EndpointMinor), 1)).0</EndpointCompatibleBelow>
  </PropertyGroup>
  <Target Name="EndpointDependencyRanges" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                      ProjectVersion="[%(ProjectVersion), $(EndpointCompatibleBelow))" />
    </ItemGroup>
  </Target>

  <!-- Release builds make the NuGet packages in output\ (doCopy.bat copies
       them to D:\Local Nuget) and, if NugetPackerOutputDirectory is set,
       copy them there too. Signing is off while testing: for a release, build
       with -p:EndpointSign=true to sign the DLLs with GHI's certificate first
       (VsixSignerCertificatePath, VsixSignerCertificatePassword,
       AssemblySignerCertificateSha1). -->
  <!-- IsPackable=false opts a project out of 0.3.0 (Update, Devices.DigitalSignal,
       Devices.Usb). Build still runs so the source doesn't rot; Pack is skipped. -->
  <Target Name="EndpointPack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(IsPackable)' != 'false'">
    <Exec Condition="'$(EndpointSign)' == 'true'" Command="signtool.exe sign /fd sha512 /f &quot;$(VsixSignerCertificatePath)&quot; /p &quot;$(VsixSignerCertificatePassword)&quot; /t &quot;http://timestamp.digicert.com&quot; /sha1 &quot;$(AssemblySignerCertificateSha1)&quot; &quot;$(TargetPath)&quot;" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Pack"
             Properties="NoBuild=true;Configuration=$(Configuration);PackageOutputPath=$(MSBuildThisFileDirectory)output\" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)output\$(PackageId).$(PackageVersion).nupkg"
          DestinationFolder="$(NugetPackerOutputDirectory)" Condition="'$(NugetPackerOutputDirectory)' != ''" />
  </Target>
</Project>
