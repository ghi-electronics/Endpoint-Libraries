<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Devices.Sound</PackageId>
    <Description>Play and record WAV / MP3 on any sound card of the board, with the API of .NET IoT's SoundDevice (Iot.Device.Media).</Description>
