  <Import Project="..\Endpoint.Libraries.props" />

  <PropertyGroup>
    <PackageId>GHIElectronics.Endpoint.Devices.Usb</PackageId>
    <Description>USB device types for Endpoint.</Description>
    <Nullable>disable</Nullable>
